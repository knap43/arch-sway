#!/usr/bin/env bash
# Lock / suspend / log out / reboot / power off, picked from fuzzel.
choice=$(printf '%s\n' Lock Suspend "Log out" Reboot "Power off" \
    | fuzzel --dmenu --prompt "Power: " --lines 5 --width 20) || exit 0
case $choice in
    Lock)        swaylock -f -c 1e1e1e ;;
    Suspend)     systemctl suspend ;;
    "Log out")
        if   [[ -n ${SWAYSOCK-} ]];                    then swaymsg exit
        elif [[ -n ${HYPRLAND_INSTANCE_SIGNATURE-} ]]; then hyprctl dispatch 'hl.dsp.exit()'
        else loginctl terminate-session "${XDG_SESSION_ID:-self}"
        fi ;;
    Reboot)      systemctl reboot ;;
    "Power off") systemctl poweroff ;;
esac
