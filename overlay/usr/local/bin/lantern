#!/usr/bin/env bash
# Lantern (https://github.com/knap43/lantern), bundled into the ISO at build time.
# One command instead of two terminals: starts the llama.cpp Dungeon Master in
# the background if it isn't already running, plays, and stops it on exit.
set -u
LIB=/usr/lib/lantern
PORT=${LANTERN_PORT:-8080}
export LANTERN_URL=${LANTERN_URL:-http://127.0.0.1:$PORT}
log=${XDG_STATE_HOME:-$HOME/.local/state}/lantern/server.log
mkdir -p "$(dirname "$log")"

# The ISO ships the fine-tuned DM, so it works offline. A newer copy that
# Lantern downloaded into ~/.cache wins; otherwise use the bundled one.
if [[ -z ${LANTERN_MODEL:-} ]]; then
    eval "$(grep -E '^TUNED=' "$LIB/scripts/serve.sh")"
    bundled=/usr/share/lantern/models/$(basename "$TUNED")
    [[ ! -f $TUNED && -f $bundled ]] && export LANTERN_MODEL=$bundled
fi

# First run without a bundled model: download the fine-tuned DM here, with a visible progress bar,
# rather than inside the background server. The URL and checksum come from
# serve.sh itself, so they stay in step with Lantern.
if [[ -z ${LANTERN_MODEL:-} ]]; then
    eval "$(grep -E '^TUNED(_URL|_SHA256)?=' "$LIB/scripts/serve.sh")"
    if [[ ! -f $TUNED ]]; then
        echo "First run: downloading the Dungeon Master (~530 MB, once)."
        mkdir -p "$(dirname "$TUNED")"
        if curl -fL --progress-bar -o "$TUNED.part" "$TUNED_URL" \
            && echo "$TUNED_SHA256  $TUNED.part" | sha256sum -c --quiet -; then
            mv "$TUNED.part" "$TUNED"
        else
            rm -f "$TUNED.part"
            echo "Download failed; Lantern will fall back to the base model." >&2
            sleep 3
        fi
    fi
fi

server=
if ! curl -fs -o /dev/null --max-time 2 "$LANTERN_URL/health"; then
    "$LIB/scripts/serve.sh" >"$log" 2>&1 &
    server=$!
    trap 'kill "$server" 2>/dev/null' EXIT
fi

PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}" python3 -c 'from lantern.app import main; main()'
