#!/usr/bin/env python3
"""Desktop settings: keyboard, display, look & behaviour, power & idle.

The same in sway, Hyprland and Mango. Saving writes ~/.config/mbp/settings.conf
through mbp-conf and applies it to the running session.
"""
import glob, json, os, subprocess

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, Vertical, VerticalScroll
from textual.suggester import SuggestFromList
from textual.widgets import (Button, Footer, Input, Label, Select, Static, Switch,
                             TabbedContent, TabPane)

SECTIONS = ["Keyboard", "Display", "Look & behaviour", "Power & idle"]
CHOICE_LABELS = {
    "auto": "Automatic", "on": "On", "off": "Off", "keep": "Leave as it was",
    "tabbed": "Tabbed", "tiled": "Tiled",
    "battery": "Only on battery", "always": "Always", "never": "Never",
}


def mbp_conf(*args):
    return subprocess.run(["mbp-conf", *args], capture_output=True, text=True)


def wallpapers():
    found = []
    for pattern in ("/usr/share/backgrounds/**/*", os.path.expanduser("~/Pictures/**/*")):
        found += [p for p in glob.glob(pattern, recursive=True)
                  if p.lower().endswith((".jpg", ".jpeg", ".png", ".webp"))]
    return sorted(found)


class Setting(Horizontal):
    """One row: the label (and help) on the left, the control on the right."""

    def __init__(self, spec):
        super().__init__(classes="setting")
        self.spec = spec

    def compose(self) -> ComposeResult:
        s = self.spec
        with Vertical(classes="text"):
            yield Label(s["label"], classes="label")
            if s["help"]:
                yield Static(s["help"], classes="help")
        wid = f"w-{s['key']}"
        if s["kind"] == "choice":
            unit = "%" if s["key"] == "BRIGHTNESS" else ""
            options = [(CHOICE_LABELS.get(c, c + unit), c) for c in s["choices"]]
            yield Select(options, value=s["value"], allow_blank=False, id=wid)
        elif s["kind"] == "bool":
            yield Switch(value=s["value"] == "on", id=wid)
        elif s["kind"] == "int":
            lo, hi = s["range"]
            yield Input(s["value"], type="integer", placeholder=f"{lo}–{hi}", id=wid)
        elif s["kind"] == "path":
            yield Input(s["value"], suggester=SuggestFromList(wallpapers(), case_sensitive=True), id=wid)
        else:
            yield Input(s["value"], id=wid)

    def current(self):
        w = self.query_one(f"#w-{self.spec['key']}")
        if isinstance(w, Switch):
            return "on" if w.value else "off"
        return str(w.value).strip()


class Settings(App):
    TITLE = "Desktop settings"
    ENABLE_COMMAND_PALETTE = False
    CSS = """
    Screen { background: #1e1e1e; color: #dddddd; }
    #title { height: 1; padding: 0 1; background: #5e81ac; color: #ffffff; text-style: bold; }
    TabbedContent { height: 1fr; }
    Tabs { background: #2a2a2a; }
    Tab { color: #888888; }
    Tab.-active, Tabs:focus Tab.-active { color: #ffffff; background: #5e81ac; text-style: bold; }
    Underline > .underline--bar { background: #3b3b3b; color: #5e81ac; }
    TabPane { padding: 0 1; }
    .setting { height: auto; padding: 1 0 0 0; }
    .text { width: 1fr; height: auto; padding-right: 2; }
    .label { color: #ffffff; }
    .help { color: #888888; }
    Select { width: 30; }
    Input { width: 30; border: tall #3b3b3b; background: #2a2a2a; }
    Input:focus { border: tall #5e81ac; }
    Input.-invalid { border: tall #bf616a; }
    #w-WALLPAPER { width: 48; }
    SelectCurrent { border: tall #3b3b3b; background: #2a2a2a; }
    Select:focus > SelectCurrent { border: tall #5e81ac; }
    Switch { border: tall #3b3b3b; background: #2a2a2a; }
    Switch:focus { border: tall #5e81ac; }
    Switch > .switch--slider { color: #3b3b3b; background: #2a2a2a; }
    Switch.-on > .switch--slider { color: #5e81ac; }
    #bar { height: 3; padding: 0 1; background: #2a2a2a; }
    #status { width: 1fr; height: 3; content-align: left middle; color: #888888; }
    Button { min-width: 12; border: none; height: 3; background: #3b3b3b; color: #ffffff; margin-left: 1; }
    Button:hover, Button:focus { background: #5e81ac; text-style: bold; }
    Footer { background: #2a2a2a; }
    FooterKey { background: #2a2a2a; color: #cccccc; }
    FooterKey .footer-key--key { background: #2a2a2a; color: #81a1c1; text-style: bold; }
    """
    BINDINGS = [
        Binding("ctrl+s", "save", "Save & apply"),
        Binding("ctrl+r", "revert", "Undo changes"),
        Binding("q,escape", "quit_app", "Quit"),
    ]

    def __init__(self):
        super().__init__()
        self.schema = json.loads(mbp_conf("schema").stdout)
        self.saved = {s["key"]: s["value"] for s in self.schema}
        self.quit_armed = False

    def compose(self) -> ComposeResult:
        yield Static("Desktop settings", id="title")
        with TabbedContent(*SECTIONS):
            for section in SECTIONS:
                with TabPane(section):
                    with VerticalScroll():
                        for s in self.schema:
                            if s["section"] == section:
                                yield Setting(s)
        with Horizontal(id="bar"):
            yield Static("", id="status")
            yield Button("Undo changes", id="revert")
            yield Button("Save & apply", id="save")
        yield Footer()

    # -- state -----------------------------------------------------------------
    def values(self):
        return {row.spec["key"]: row.current() for row in self.query(Setting)}

    def changed(self):
        return {k: v for k, v in self.values().items() if v != self.saved[k]}

    def on_mount(self):
        self.refresh_status()

    def refresh_status(self, message=None):
        n = len(self.changed())
        text = message or (f"{n} unsaved change{'s' if n != 1 else ''}" if n else "All saved")
        self.query_one("#status", Static).update(text)

    def on_input_changed(self, event):
        self.refresh_status()

    def on_switch_changed(self, event):
        self.refresh_status()

    def on_select_changed(self, event):
        self.refresh_status()

    def on_button_pressed(self, event):
        {"save": self.action_save, "revert": self.action_revert}[event.button.id]()

    # -- actions ---------------------------------------------------------------
    def action_save(self):
        changes = self.changed()
        if not changes:
            self.refresh_status("Nothing to save")
            return
        result = mbp_conf("set", *(f"{k}={v}" for k, v in changes.items()))
        if result.returncode != 0:
            message = result.stderr.strip().removeprefix("mbp-conf: ")
            self.refresh_status(message)
            self.notify(message, title="Not saved", severity="error")
            return
        self.saved.update(changes)
        applied = mbp_conf("apply").stdout.strip()
        self.refresh_status(f"Saved. {applied}")

    def action_revert(self):
        for row in self.query(Setting):
            w = row.query_one(f"#w-{row.spec['key']}")
            value = self.saved[row.spec["key"]]
            if isinstance(w, Switch):
                w.value = value == "on"
            else:
                w.value = value
        self.refresh_status("Changes undone")

    def action_quit_app(self):
        if self.changed() and not self.quit_armed:
            self.quit_armed = True
            self.refresh_status("Unsaved changes: Ctrl+S saves, Q again quits without saving")
            return
        self.exit()


if __name__ == "__main__":
    Settings().run()
