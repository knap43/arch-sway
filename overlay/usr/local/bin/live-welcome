#!/usr/bin/env bash
# Live session only: a short walkthrough that ends in the installer.

b=$'\e[1m' d=$'\e[2m' r=$'\e[0m' red=$'\e[31m' grn=$'\e[32m' ylw=$'\e[33m' blu=$'\e[34m'

flavour=$(cat /etc/mbp-live 2>/dev/null || echo sway)

online() {
    [[ $(nmcli -t networking connectivity 2>/dev/null) == full ]]
}

# The ISO carries every package, so the installer works without internet.
offline_install() { [[ -f /var/lib/mbp/repo/mbp.db ]]; }

page() {
    clear
    printf '%s\n\n' "${b}Welcome to mbp-$flavour${r}  ${d}— Arch Linux + $flavour${r}"
    printf '%s\n' "This is the live system, running from the USB stick. Nothing on the"
    printf '%s\n\n' "internal disk has been touched yet."

    if offline_install; then
        printf '%s\n' "${b}1. Connect to Wi-Fi${r} ${d}(optional — installing needs no internet)${r}"
        printf '   %s\n' "Networks you join now are saved in the new system, passwords included."
    else
        printf '%s\n' "${b}1. Connect to the internet${r}"
    fi
    if online; then
        printf '   %s\n\n' "${grn}✓ Connected${r}"
    else
        printf '   %s\n' "${ylw}✗ Not connected${r}"
        printf '   %s\n' "Press ${b}W${r} to pick a Wi-Fi network, or use the network icon in the bar."
        offline_install || printf '   %s\n' "${d}No Wi-Fi? Plug in your phone and turn on USB tethering.${r}"
        echo
    fi

    printf '%s\n' "${b}2. Try things out${r} ${d}(optional)${r}"
    printf '   %s\n' "⌘ = Command key (on a PC: Alt, swapped with Win).  ⌘D terminal · ⌘Space launcher · ⌘W close"
    printf '   %s\n' "⌘A / ⌘S workspaces · ⌘⇧Q or ⌘Esc power menu · Alt+Shift US ⇄ RU"
    printf '   %s\n\n' "Caps Lock and Escape are swapped. Press ${b}K${r} for every shortcut."

    printf '%s\n' "${b}3. Install${r}"
    printf '   %s\n' "The installer asks for a disk, a name for this computer, your user"
    printf '   %s\n' "and password, timezone and language, then installs the same"
    printf '   %s\n' "system you see now. Saved Wi-Fi networks are carried over."
    printf '   %s\n\n' "${red}${b}The whole disk you choose is erased, macOS or Windows included.${r}"

    printf '%s\n' "${blu}Enter${r} install   ${blu}W${r} Wi-Fi   ${blu}K${r} shortcuts   ${blu}Q${r} close this window"
}

keys() {
    clear
    local readme=/usr/local/share/mbp/README.md
    if [[ -f $readme ]]; then
        # The shared table, then the one under "### <this flavour>".
        awk -v fl="$flavour" '
            /^## /  { inkeys = ($0 ~ /^## Keys/); keep = inkeys; next }
            /^### / { keep = inkeys && tolower($2) == fl; next }
            keep' "$readme" \
            | grep '^|' | grep -v -- '---' | grep -v '^| Keys |' \
            | sed 's/^| //; s/ |$//; s/ | /\t/; s/\\\(.\)/\1/g' | column -t -s $'\t'
    else
        echo "Shortcut list not found."
    fi
    printf '\n%s' "${d}Press any key to go back${r}"
    read -rsn1
}

install() {
    clear
    if ! offline_install && ! online; then
        printf '%s\n\n' "${ylw}You're not connected yet — the installer downloads its packages.${r}"
        printf '%s' "Press W to connect, or any other key to go back. "
        read -rsn1 k
        [[ ${k,,} == w ]] && nmtui connect
        return
    fi
    sudo mbp-install
    status=$?
    echo
    if (( status == 0 )); then
        # The live system runs from the stick, down to the shutdown itself, so
        # the stick must stay in until the machine is off.
        printf '%s\n' "${grn}${b}Done.${r} Press Enter to power off (Q to stay)."
        printf '%s\n' "${ylw}Keep the USB stick in until the machine is off${r}, then remove it and turn it on."
        read -rsn1 k
        [[ ${k,,} == q ]] || systemctl poweroff
    else
        printf '%s' "${ylw}The installer stopped.${r} Press any key to go back. "
        read -rsn1
    fi
}

while :; do
    page
    read -rsn1 -t 5 key || continue     # redraw every 5 s so the network line updates
    case ${key,,} in
        "")  install ;;
        w)   nmtui connect ;;
        k)   keys ;;
        q)   exit 0 ;;
    esac
done
