#!/usr/bin/env bash
# mbp-update: brings an installed system up to date with the arch-sway repo.
#
#   mbp-update            fetch, show what's new, ask, then update
#   mbp-update --check    only show what's new
#   mbp-update --yes      don't ask (pacman still asks about its own changes)
#   mbp-update --force    update even when the installed version is the newest
#
# It fetches the repo (MBP_REPO=..., branch MBP_BRANCH=..., default main) into
# ~/.cache/mbp/arch-sway, has `build.sh --stage` lay out this flavour's files
# (and the bundled apps: Tether, RetroHub, toofan, the emulators, tiny-games,
# Zen's extensions), and then:
#   - installs packages the lists have gained, with a full system upgrade
#     (packages they have dropped are only listed, with the command to remove them);
#   - installs the new files with mbp-install-files, removing ones since dropped;
#   - updates Zen (Flatpak);
#   - updates your own config files in ~/.config: ones you haven't changed are
#     replaced, missing ones are added, and where you have changed one, yours
#     stays and the new version is put next to it as FILE.new;
#   - regenerates the desktop from your Settings and reloads it.
# Run it as yourself, not as root; it asks for your password where it needs to.
set -euo pipefail

REPO=${MBP_REPO:-https://github.com/knap43/arch-sway}
BRANCH=${MBP_BRANCH:-main}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/mbp
CLONE=$CACHE/arch-sway
SHARE=/usr/local/share/mbp

bold=$'\e[1m' dim=$'\e[2m' green=$'\e[32m' yellow=$'\e[33m' red=$'\e[31m' off=$'\e[0m'
[[ -t 1 ]] || bold= dim= green= yellow= red= off=
say()  { printf '%s::%s %s\n' "$bold$green" "$off$bold" "$*$off"; }
note() { printf '   %s\n' "$*"; }
warn() { printf '%s!!%s %s\n' "$bold$yellow" "$off" "$*" >&2; }
die()  { printf '%s!!%s %s\n' "$bold$red" "$off" "$*" >&2; exit 1; }

check=0 yes=0 force=0
for a in "$@"; do
    case $a in
        --check) check=1 ;;
        --yes|-y) yes=1 ;;
        --force) force=1 ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown option $a (see mbp-update --help)" ;;
    esac
done
(( EUID != 0 )) || die "Run mbp-update as yourself, not as root: it updates your own configs too, and asks for your password when it needs it."
[[ ! -f /etc/mbp-live ]] || die "This is the live system; mbp-update is for installed ones."
command -v git >/dev/null || die "git is missing: sudo pacman -S git"

# ---- Fetch --------------------------------------------------------------------
say "Fetching $REPO ($BRANCH)"
mkdir -p "$CACHE"
if [[ -d $CLONE/.git ]]; then
    git -C "$CLONE" remote set-url origin "$REPO"
    git -C "$CLONE" fetch -q origin "$BRANCH"
    git -C "$CLONE" checkout -q -f -B "$BRANCH" FETCH_HEAD
    git -C "$CLONE" clean -q -fdx -e cache/
else
    rm -rf "$CLONE"
    git clone -q --branch "$BRANCH" "$REPO" "$CLONE"
fi
new=$(git -C "$CLONE" rev-parse HEAD)
old=$(cat "$SHARE/version" 2>/dev/null || true)

if [[ $old == "$new" ]]; then
    note "Installed: ${new:0:7}, the newest."
    (( force )) || { (( check )) || note "Nothing to do (mbp-update --force runs it anyway)."; exit 0; }
elif [[ -n $old ]] && git -C "$CLONE" cat-file -e "$old^{commit}" 2>/dev/null; then
    n=$(git -C "$CLONE" rev-list --count "$old..$new")
    note "Installed: ${old:0:7}; newest: ${new:0:7}, $n commit$( ((n == 1)) || echo s) later:"
    git -C "$CLONE" log --format="     $dim%h$off %s" "$old..$new" | head -40
    (( n <= 40 )) || note "     … and $((n - 40)) more"
else
    note "Installed version unknown (installed before mbp-update existed); newest: ${new:0:7}."
    note "Latest changes:"
    git -C "$CLONE" log --format="     $dim%h$off %s" -10
fi
(( check )) && exit 0

# ---- Flavour ------------------------------------------------------------------
flavour=$(cat "$SHARE/flavour" 2>/dev/null || true)
if [[ -z $flavour ]]; then
    for f in sway hyprland mango; do
        pkg=$(sed -E 's/#.*//; /^[[:space:]]*$/d' "$CLONE/compositors/$f/packages" | head -1 | tr -d '[:space:]')
        pacman -Qq "$pkg" >/dev/null 2>&1 && { flavour=$f; break; }
    done
    [[ -n $flavour ]] || die "Couldn't tell which flavour this is (sway, hyprland or mango)."
fi
[[ -d $CLONE/compositors/$flavour ]] || die "The repo no longer has the $flavour flavour."
note "Flavour: $flavour"

if (( ! yes )); then
    read -rp "${bold}Update now? [Y/n]${off} " ans
    [[ ${ans,,} == "" || ${ans,,} == y* ]] || exit 0
fi
sudo -v || die "This needs your password (for the system files and packages)."

# ---- Stage --------------------------------------------------------------------
STAGE=$(mktemp -d /tmp/mbp-update.XXXXXX)
OLD_SKEL=$(mktemp -d /tmp/mbp-skel.XXXXXX)
trap 'rm -rf "$STAGE" "$OLD_SKEL"' EXIT
say "Preparing the new files"
bash "$CLONE/build.sh" --stage "$STAGE" "$flavour" 2>&1 | sed 's/^/   /' \
    || die "Preparing the files failed; nothing has been changed."
chmod 755 "$STAGE"

# ---- Packages -----------------------------------------------------------------
say "Packages"
mapfile -t want < "$STAGE$SHARE/packages.system"
mapfile -t missing < <(pacman -T "${want[@]}" 2>/dev/null || true)
if (( ${#missing[@]} )); then
    note "New: ${missing[*]}"
    sudo pacman -Syu --needed "${missing[@]}"
else
    note "None new; upgrading the system."
    sudo pacman -Syu
fi
# Dropped since the installed version; for a system installed before
# mbp-update existed, every package the lists have ever dropped.
old_list() {
    if [[ -f $SHARE/packages.system ]]; then
        cat "$SHARE/packages.system"
    else
        git -C "$CLONE" log -p --format= -- packages.system "compositors/$flavour/packages" \
            | sed -nE 's/^-([^-#[:space:]][^#[:space:]]*).*/\1/p'
    fi
}
dropped=()
while IFS= read -r p; do
    pacman -Qq "$p" >/dev/null 2>&1 && dropped+=("$p")
done < <(comm -23 <(old_list | sort -u) <(printf '%s\n' "${want[@]}" | sort -u))

# ---- System files -------------------------------------------------------------
say "Installing the new files"
cp -a /etc/skel/. "$OLD_SKEL/" 2>/dev/null || true
sudo bash "$STAGE/usr/local/bin/mbp-install-files" "$STAGE" / | sed 's/^/   /'
sudo glib-compile-schemas /usr/share/glib-2.0/schemas
sudo systemctl daemon-reload
systemctl --user daemon-reload 2>/dev/null || true

# ---- Zen ----------------------------------------------------------------------
if command -v flatpak >/dev/null && flatpak --system list --app --columns=application 2>/dev/null | grep -q .; then
    say "Updating Flatpak apps (Zen)"
    sudo flatpak --system update -y --noninteractive | sed 's/^/   /' || warn "Flatpak update failed; try again later with: sudo flatpak update"
fi

# ---- Your configs -------------------------------------------------------------
say "Updating your configs"
# Yours to keep: Settings' and the shortcuts' values, and what's generated from them.
skip() {
    case $1 in
        .config/mbp/generated/*|.config/mbp/settings.conf|.config/mbp/shortcuts.conf) return 0 ;;
    esac
    return 1
}
# Compares two versions, leaving out what Settings itself writes into the file.
same() {
    case $3 in
        .config/gtk-3.0/settings.ini)
            cmp -s <(grep -v '^gtk-application-prefer-dark-theme=' "$1") \
                   <(grep -v '^gtk-application-prefer-dark-theme=' "$2") ;;
        *) cmp -s "$1" "$2" ;;
    esac
}
added=() updated=() kept=() removed=()
while IFS= read -r -d '' f; do
    r=${f#/etc/skel/}
    skip "$r" && continue
    mine=$HOME/$r
    if [[ ! -e $mine ]]; then
        install -D -m "$(stat -c %a "$f")" "$f" "$mine"
        added+=("$r")
    elif same "$f" "$mine" "$r"; then
        rm -f "$mine.new"
    elif [[ -f $OLD_SKEL/$r ]] && same "$OLD_SKEL/$r" "$mine" "$r"; then
        install -m "$(stat -c %a "$f")" "$f" "$mine"
        rm -f "$mine.new"
        updated+=("$r")
    else
        install -m 644 "$f" "$mine.new"
        kept+=("$r")
    fi
done < <(find /etc/skel -type f -print0 | sort -z)
# Files the defaults no longer have: removed if you never changed them.
while IFS= read -r -d '' f; do
    r=${f#"$OLD_SKEL/"}
    skip "$r" && continue
    [[ -e /etc/skel/$r ]] && continue
    mine=$HOME/$r
    if [[ -f $mine ]] && same "$f" "$mine" "$r"; then
        rm -f "$mine"
        removed+=("$r")
    fi
done < <(find "$OLD_SKEL" -type f -print0 | sort -z)
for r in "${updated[@]}"; do note "updated  ~/$r"; done
for r in "${added[@]}";   do note "added    ~/$r"; done
for r in "${removed[@]}"; do note "removed  ~/$r"; done
(( ${#updated[@]} + ${#added[@]} + ${#removed[@]} + ${#kept[@]} )) || note "Nothing changed."

# ---- Apply --------------------------------------------------------------------
say "Applying your settings"
mbp-conf generate
note "$(mbp-conf apply 2>&1 || true)"

# ---- Summary ------------------------------------------------------------------
echo
say "Updated to ${new:0:7}."
if (( ${#kept[@]} )); then
    echo
    warn "You have changed these, so yours were kept and the new defaults saved next to them as .new:"
    for r in "${kept[@]}"; do note "~/$r"; done
    note "Compare with e.g.  diff ~/${kept[0]} ~/${kept[0]}.new"
    note "To take the new one:  mv ~/${kept[0]}.new ~/${kept[0]}"
fi
if (( ${#dropped[@]} )); then
    echo
    warn "No longer in the package lists, but still installed:"
    note "${dropped[*]}"
    note "Remove them, if you don't use them yourself, with:"
    note "  sudo pacman -Rns ${dropped[*]}"
fi
echo
note "Some changes (new services, the keyboard layout) apply from your next login."
