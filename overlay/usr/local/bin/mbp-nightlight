#!/usr/bin/env bash
# Night light at the temperature from the desktop settings (default 4000 K).
# wlsunset needs a day and a night value, so day is 1 K higher than night,
# which keeps the tint constant.
#   mbp-nightlight start    start it, unless switched off in the settings
#   mbp-nightlight toggle   on/off for this session (Mod+N)
temp=$(mbp-conf get NIGHTLIGHT_TEMP 2>/dev/null); temp=${temp:-4000}
run() { exec wlsunset -t "$temp" -T $((temp + 1)) -S 06:00 -s 18:00; }
case ${1:-start} in
    start)  [[ $(mbp-conf get NIGHTLIGHT 2>/dev/null) == off ]] && exit 0
            pgrep -x wlsunset >/dev/null || run ;;
    toggle) pkill -x wlsunset || run ;;
esac
