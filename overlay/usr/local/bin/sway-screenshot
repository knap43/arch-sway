#!/usr/bin/env bash
# sway-screenshot          select a region (click a window's area or drag)
# sway-screenshot --full   whole screen
# Saves to ~/Pictures/Screenshots and copies the image to the clipboard.
set -e
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%F_%H-%M-%S).png"
if [[ $1 == --full ]]; then
    grim "$file"
else
    region=$(slurp) || exit 0          # Esc cancels
    grim -g "$region" "$file"
fi
wl-copy < "$file"
notify-send -i "$file" "Screenshot saved" "$file"
