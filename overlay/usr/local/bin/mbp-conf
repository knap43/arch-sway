BY_KEY = {s[0]: s for s in SCHEMA}


# ---- reading and writing ----------------------------------------------------
def load():
    values = {key: s[4] for key, s in BY_KEY.items()}
    try:
        with open(SETTINGS) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key, value = key.strip(), value.strip()
                if key in BY_KEY and validate(key, value) is None:
                    values[key] = value
    except FileNotFoundError:
        pass
    return values


def validate(key, value):
    """None if fine, otherwise a message."""
    if key not in BY_KEY:
        return f"unknown setting {key}"
    _, _, label, kind, _, extra, _ = BY_KEY[key]
    if kind == "choice" and value not in extra:
        return f"{label}: one of {', '.join(extra)}"
    if kind == "bool" and value not in ("on", "off"):
        return f"{label}: on or off"
    if kind == "int":
        if not re.fullmatch(r"-?\d+", value) or not extra[0] <= int(value) <= extra[1]:
            return f"{label}: a whole number from {extra[0]} to {extra[1]}"
    if kind == "text" and not re.fullmatch(extra, value):
        return f"{label}: not in the expected form"
    if kind == "path" and (not value or "\n" in value):
        return f"{label}: a file path"
    if kind == "json":
        try:
            if not isinstance(json.loads(value), dict):
                raise ValueError
        except ValueError:
            return f"{label}: a JSON object"
    return None


def save(values):
    os.makedirs(CONF_DIR, exist_ok=True)
    lines = ["# Desktop settings; change them with mbp-settings (or edit, then: mbp-conf apply)."]
    section = None
    for key, sec, label, *_ in SCHEMA:
        if sec != section:
            lines += ["", f"# {sec}"]
            section = sec
        lines.append(f"{key}={values[key]}")
    tmp = SETTINGS + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, SETTINGS)


# ---- values that depend on the machine ----------------------------------------
def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def swap_alt_win(v):
    if v["SWAP_ALT_WIN"] != "auto":
        return v["SWAP_ALT_WIN"] == "on"
    return not read(f"{SYSFS}/class/dmi/id/sys_vendor").startswith("Apple")


def xkb_options(v):
    opts = ["mbp:swap_alt_win"] if swap_alt_win(v) else ["grp:alt_shift_toggle"]
    if v["SWAP_CAPS_ESC"] == "on":
        opts.insert(0, "caps:swapescape")
    return ",".join(opts)


def outputs():
    """[(name, preferred height)] for every connected display."""
    found = []
    for d in sorted(glob.glob(f"{SYSFS}/class/drm/card*-*")):
        if read(f"{d}/status") != "connected":
            continue
        m = re.match(r"(\d+)x(\d+)", read(f"{d}/modes").split("\n")[0])
        name = re.sub(r"^card\d+-", "", os.path.basename(d))
        found.append((name, int(m.group(2)) if m else 0))
    return found


TRANSFORMS = ["normal", "90", "180", "270"]


def displays(v):
    """{output: {"mode": "WxH@R", "x", "y", "scale", "transform", "enabled"}}."""
    try:
        d = json.loads(v["DISPLAYS"])
    except ValueError:
        return {}
    return {k: c for k, c in d.items() if isinstance(c, dict)}


def scales(v):
    """[(output, scale)] for displays that shouldn't be at 1."""
    custom = displays(v)
    if v["SCALE"] == "auto":
        auto = [(name, 1.5) for name, height in outputs() if height >= 1080]
    else:
        s = float(v["SCALE"])
        auto = [] if s == 1 else [(name, s) for name, _ in outputs()]
    return [(n, s) for n, s in auto if n not in custom]


def mode_parts(mode):
    m = re.fullmatch(r"(\d+)x(\d+)(?:@([\d.]+))?", str(mode or ""))
    return (int(m.group(1)), int(m.group(2)), float(m.group(3)) if m.group(3) else None) if m else None


# ---- the compositor snippets -------------------------------------------------
HEADER = "Generated by mbp-conf from ~/.config/mbp/settings.conf: change it with mbp-settings."


def on(v, key):
    return v[key] == "on"


def fmt(x):
    return f"{x:g}"


def accent(v):
    return ACCENTS[v["ACCENT"]]


def sway_vars(v):
    bg, fg = accent(v)
    return "\n".join([
        f"# {HEADER}",
        f"set $accent #{bg}",
        f"set $accent_text #{fg}",
        f"set $border {v['BORDER_WIDTH']}",
        f"set $gaps_inner {v['GAPS_INNER']}",
        f"set $gaps_outer {v['GAPS_OUTER']}",
    ]) + "\n"


def sway_conf(v):
    lines = [f"# {HEADER}",
             "input type:keyboard {",
             f"    xkb_layout {v['LAYOUTS']}",
             f"    xkb_options {xkb_options(v)}",
             f"    repeat_delay {v['REPEAT_DELAY']}",
             f"    repeat_rate {v['REPEAT_RATE']}",
             "}",
             "input type:touchpad {",
             f"    natural_scroll {'enabled' if on(v, 'NATURAL_SCROLL') else 'disabled'}",
             f"    tap {'enabled' if on(v, 'TAP_TO_CLICK') else 'disabled'}",
             f"    dwt {'enabled' if on(v, 'DISABLE_WHILE_TYPING') else 'disabled'}",
             f"    pointer_accel {accel(v)}",
             f"    left_handed {'enabled' if on(v, 'LEFT_HANDED') else 'disabled'}",
             "}",
             "input type:pointer {",
             f"    pointer_accel {accel(v)}",
             f"    left_handed {'enabled' if on(v, 'LEFT_HANDED') else 'disabled'}",
             "}",
             f"focus_follows_mouse {'yes' if on(v, 'FOCUS_FOLLOWS_MOUSE') else 'no'}",
             f"workspace_layout {'tabbed' if v['DEFAULT_LAYOUT'] == 'tabbed' else 'default'}",
             f"output * bg {shlex.quote(v['WALLPAPER'])} fill #1e1e1e",
             "output * scale 1"]
    lines += [f"output {name} scale {fmt(s)}" for name, s in scales(v)]
    for name, c in displays(v).items():
        if c.get("enabled") is False:
            lines.append(f"output {name} disable")
            continue
        parts = [f"output {name} enable"]
        mp = mode_parts(c.get("mode"))
        if mp:
            parts.append(f"mode {mp[0]}x{mp[1]}" + (f"@{mp[2]:.3f}Hz" if mp[2] else ""))
        if "x" in c and "y" in c:
            parts.append(f"position {int(c['x'])} {int(c['y'])}")
        if c.get("transform") in TRANSFORMS:
            parts.append(f"transform {c['transform']}")
        if c.get("scale"):
            parts.append(f"scale {fmt(float(c['scale']))}")
        lines.append(" ".join(parts))
    lines += [f"seat * hide_cursor {int(v['HIDE_CURSOR_SEC']) * 1000}",
              f"seat * hide_cursor when-typing {'enable' if on(v, 'HIDE_CURSOR_TYPING') else 'disable'}"]
    if on(v, "SWIPE_WORKSPACES"):
        lines += ["bindgesture swipe:3:left exec sway-workspace-next",
                  "bindgesture swipe:3:right workspace prev_on_output"]
    return "\n".join(lines) + "\n"


def accel(v):
    return f"{int(v['POINTER_SPEED']) / 100:g}"


def lua_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def hypr_displays(v):
    out = []
    for name, c in displays(v).items():
        fields = [f"output = {lua_str(name)}"]
        if c.get("enabled") is False:
            fields.append("disabled = true")
        else:
            mp = mode_parts(c.get("mode"))
            mode = "preferred"
            if mp:
                mode = f"{mp[0]}x{mp[1]}" + (f"@{mp[2]:g}" if mp[2] else "")
            position = f"{int(c['x'])}x{int(c['y'])}" if "x" in c and "y" in c else "auto"
            fields += [f"mode = {lua_str(mode)}", f"position = {lua_str(position)}",
                       f"scale = {fmt(float(c.get('scale') or 1))}"]
            if c.get("transform") in TRANSFORMS:
                fields.append(f"transform = {TRANSFORMS.index(c['transform'])}")
        out.append("{ " + ", ".join(fields) + " }")
    return ", ".join(out)


def hyprland_lua(v):
    mons = ", ".join(f"{{ output = {lua_str(n)}, scale = {fmt(s)} }}" for n, s in scales(v))
    return "\n".join([
        f"-- {HEADER}",
        "return {",
        f"    kb_layout = {lua_str(v['LAYOUTS'])},",
        f"    kb_options = {lua_str(xkb_options(v))},",
        f"    repeat_delay = {v['REPEAT_DELAY']},",
        f"    repeat_rate = {v['REPEAT_RATE']},",
        f"    follow_mouse = {1 if on(v, 'FOCUS_FOLLOWS_MOUSE') else 0},",
        f"    natural_scroll = {str(on(v, 'NATURAL_SCROLL')).lower()},",
        f"    tap_to_click = {str(on(v, 'TAP_TO_CLICK')).lower()},",
        f"    tabbed = {str(v['DEFAULT_LAYOUT'] == 'tabbed').lower()},",
        f"    monitors = {{ {mons} }},",
        f"    accent = {lua_str(accent(v)[0])},",
        f"    accent_text = {lua_str(accent(v)[1])},",
        f"    border_size = {v['BORDER_WIDTH']},",
        f"    gaps_in = {v['GAPS_INNER']},",
        f"    gaps_out = {v['GAPS_OUTER']},",
        f"    rounding = {v['ROUNDING']},",
        f"    animations = {str(on(v, 'ANIMATIONS')).lower()},",
        f"    blur = {str(on(v, 'BLUR')).lower()},",
        f"    shadows = {str(on(v, 'SHADOWS')).lower()},",
        f"    inactive_opacity = {v['INACTIVE_OPACITY']},",
        f"    sensitivity = {accel(v)},",
        f"    left_handed = {str(on(v, 'LEFT_HANDED')).lower()},",
        f"    disable_while_typing = {str(on(v, 'DISABLE_WHILE_TYPING')).lower()},",
        f"    swipe = {str(on(v, 'SWIPE_WORKSPACES')).lower()},",
        f"    hide_cursor_sec = {v['HIDE_CURSOR_SEC']},",
        f"    hide_cursor_typing = {str(on(v, 'HIDE_CURSOR_TYPING')).lower()},",
        f"    displays = {{ {hypr_displays(v)} }},",
        "}",
    ]) + "\n"


def regex_literal(s):
    """Escape regex characters, but not "-" (eDP-1 stays eDP-1)."""
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", s)


def mango_conf(v):
    layout = "monocle" if v["DEFAULT_LAYOUT"] == "tabbed" else "tile"
    lines = [f"# {HEADER}",
             f"xkb_rules_layout={v['LAYOUTS']}",
             f"xkb_rules_options={xkb_options(v)}",
             f"repeat_delay={v['REPEAT_DELAY']}",
             f"repeat_rate={v['REPEAT_RATE']}",
             f"sloppy_focus={1 if on(v, 'FOCUS_FOLLOWS_MOUSE') else 0}",
             f"trackpad_natural_scrolling={1 if on(v, 'NATURAL_SCROLL') else 0}",
             f"tap_to_click={1 if on(v, 'TAP_TO_CLICK') else 0}"]
    bg, fg = accent(v)
    lines += [f"border_px={v['BORDER_WIDTH']}",
              f"gap_inner_horizontal={v['GAPS_INNER']}", f"gap_inner_vertical={v['GAPS_INNER']}",
              f"gap_outer_horizontal={v['GAPS_OUTER']}", f"gap_outer_vertical={v['GAPS_OUTER']}",
              f"border_radius={v['ROUNDING']}",
              f"animations={1 if on(v, 'ANIMATIONS') else 0}",
              "layer_animations=0",          # menus, bar, notifications: always instant
              f"blur={1 if on(v, 'BLUR') else 0}",
              f"shadows={1 if on(v, 'SHADOWS') else 0}",
              f"unfocused_opacity={v['INACTIVE_OPACITY']}",
              f"focus_color=0x{bg}ff", f"scratchpad_color=0x{bg}ff",
              f"tab_bar_decorate_focus_bg_color=0x{bg}ff",
              f"tab_bar_decorate_focus_fg_color=0x{fg}ff",
              f"mouse_accel_speed={accel(v)}", f"trackpad_accel_speed={accel(v)}",
              f"mouse_left_handed={1 if on(v, 'LEFT_HANDED') else 0}",
              f"trackpad_left_handed={1 if on(v, 'LEFT_HANDED') else 0}",
              f"trackpad_disable_while_typing={1 if on(v, 'DISABLE_WHILE_TYPING') else 0}",
              f"cursor_hide_timeout={v['HIDE_CURSOR_SEC']}",
              f"cursor_hide_on_keypress={1 if on(v, 'HIDE_CURSOR_TYPING') else 0}"]
    if on(v, "SWIPE_WORKSPACES"):
        lines += ["gesturebind=none,left,3,viewtoright_have_client",
                  "gesturebind=none,right,3,viewtoleft_have_client"]
    lines += [f"tag_rule=id:{i},layout_name:{layout}" for i in range(1, 10)]
    lines += [f"monitor_rule=name:^{regex_literal(n)}$,scale:{fmt(s)}" for n, s in scales(v)]
    for name, c in displays(v).items():      # rotation isn't available in Mango's monitor rules
        f = [f"name:^{regex_literal(name)}$"]
        if c.get("enabled") is False:
            f.append("disable:1")
        else:
            mp = mode_parts(c.get("mode"))
            if mp:
                f += [f"width:{mp[0]}", f"height:{mp[1]}"] + ([f"refresh:{mp[2]:g}"] if mp[2] else [])
            if "x" in c and "y" in c:
                f += [f"x:{int(c['x'])}", f"y:{int(c['y'])}"]
            f.append(f"scale:{fmt(float(c.get('scale') or 1))}")
        lines.append("monitor_rule=" + ",".join(f))
    return "\n".join(lines) + "\n"


def waybar_css(v):
    bg, fg = accent(v)
    return (f"/* {HEADER} */\n"
            "window#waybar #workspaces button.active,\n"
            "window#waybar #workspaces button.focused {\n"
            f"    background: #{bg};\n    color: #{fg};\n}}\n")


def mako_conf(v):
    timeout = int(v["NOTIFY_TIMEOUT"]) * 1000
    return "\n".join([f"# {HEADER}", f"default-timeout={timeout}", f"anchor={v['NOTIFY_POSITION']}",
                      f"border-color=#{accent(v)[0]}", "", "[mode=do-not-disturb]", "invisible=1"]) + "\n"


def gtk_settings(v):
    """GTK 3 reads its dark/light preference from settings.ini, GTK 4 from gsettings."""
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "gtk-3.0", "settings.ini")
    dark = "1" if v["THEME"] == "dark" else "0"
    try:
        lines = open(path).read().splitlines()
    except OSError:
        lines = ["[Settings]"]
    lines = [l for l in lines if not l.startswith("gtk-application-prefer-dark-theme")]
    lines.insert(1 if lines and lines[0].startswith("[") else 0, f"gtk-application-prefer-dark-theme={dark}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def gsettings(v):
    iface = "org.gnome.desktop.interface"
    quiet("gsettings", "set", iface, "color-scheme", "prefer-dark" if v["THEME"] == "dark" else "default")
    quiet("gsettings", "set", iface, "gtk-theme", "Adwaita")
    quiet("gsettings", "set", iface, "text-scaling-factor", v["TEXT_SCALE"])


def gtklock_css(v):
    """The lock screen: clock, date and a password box over the dimmed wallpaper,
    square and in the accent colour. GTK 3 CSS, for gtklock (see mbp-lock)."""
    from urllib.parse import quote
    bg, _ = accent(v)
    wall = v["WALLPAPER"]
    layers = "linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55))"
    if os.path.isfile(wall):
        layers += f', url("file://{quote(os.path.abspath(wall))}")'
    return f"""/* {HEADER} */
window {{
    background-color: #1e1e1e;
    background-image: {layers};
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}}
* {{ font-family: "JetBrains Mono", monospace; border-radius: 0; box-shadow: none; text-shadow: none; }}
#clock-label {{ font-size: 72px; color: #eeeeee; }}
#date-label {{ font-size: 16px; color: #bbbbbb; }}
#input-field {{
    background: #2a2a2a; color: #dddddd; caret-color: #{bg};
    border: 1px solid #333333; padding: 6px 10px; min-width: 260px;
}}
#input-field:focus {{ border-color: #{bg}; }}
/* gtklock puts the show-password icon back when focus moves between screens */
#input-field image {{ opacity: 0; }}
#error-label {{ color: #bf616a; }}
#warning-label {{ color: #ebcb8b; }}
"""


STYLE_PY = "/usr/lib/mbp-settings/mbpsettings/style.py"


def tether_style(v):
    """Tether's window in the same colours as Settings: both come from style.py."""
    import importlib.util
    try:
        spec = importlib.util.spec_from_file_location("mbp_style", STYLE_PY)
        style = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(style)
    except (OSError, ImportError):
        return
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "tether", "style.css")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        f.write(f"/* {HEADER} */\n" + style.tether_css(v["THEME"], v["ACCENT"]))
    os.replace(path + ".tmp", path)


def generate(v=None):
    v = v or load()
    os.makedirs(GENERATED, exist_ok=True)
    for name, text in (("sway-vars.conf", sway_vars(v)), ("sway.conf", sway_conf(v)),
                       ("hyprland.lua", hyprland_lua(v)), ("mango.conf", mango_conf(v)),
                       ("waybar.css", waybar_css(v)), ("mako.conf", mako_conf(v)),
                       ("gtklock.css", gtklock_css(v))):
        path = os.path.join(GENERATED, name)
        with open(path + ".tmp", "w") as f:
            f.write(text)
        os.replace(path + ".tmp", path)
    gtk_settings(v)
    tether_style(v)


# ---- applying to the running session -----------------------------------------
def compositor():
    if os.environ.get("SWAYSOCK"):
        return "sway"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    if subprocess.run(["pgrep", "-x", "mango"], capture_output=True).returncode == 0:
        return "mango"
    return None


def detach(*cmd):
    subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def quiet(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wallpaper(v=None):
    v = v or load()
    quiet("pkill", "-x", "swaybg")
    detach("swaybg", "-i", v["WALLPAPER"], "-m", "fill", "-c", "1e1e1e")


def restart_waybar():
    """Stop Waybar and start it again. Its in-place reload (SIGUSR2) can crash
    it, which left the bar gone after changing the accent colour."""
    import time
    quiet("pkill", "-x", "waybar")
    for _ in range(40):                                # up to 2 s for it to exit
        if subprocess.run(["pgrep", "-x", "waybar"], capture_output=True).returncode != 0:
            break
        time.sleep(0.05)
    else:
        quiet("pkill", "-KILL", "-x", "waybar")
    detach("waybar")


def apply():
    v = load()
    generate(v)
    wm = compositor()
    if wm == "sway":
        quiet("swaymsg", "reload")                     # also sets the wallpaper
    elif wm == "hyprland":
        quiet("hyprctl", "reload")
        wallpaper(v)
    elif wm == "mango":
        quiet("mmsg", "dispatch", "reload_config")
        wallpaper(v)
    if wm in ("hyprland", "mango"):
        restart_waybar()                               # new accent colour
    if wm:
        gsettings(v)
        quiet("makoctl", "reload")
        quiet("pkill", "-x", "wlsunset")
        detach("mbp-nightlight", "start")
        detach("mbp-idle")
    return wm


# ---- command line ------------------------------------------------------------
def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    if cmd == "get" and len(args) == 1 and args[0] in BY_KEY:
        print(load()[args[0]])
    elif cmd == "set" and args:
        v = load()
        for arg in args:
            key, _, value = arg.partition("=")
            err = validate(key, value)
            if err:
                sys.exit(f"mbp-conf: {err}")
            v[key] = value
        save(v)
    elif cmd == "schema":
        v = load()
        print(json.dumps([{"key": k, "section": sec, "label": label, "kind": kind, "default": d,
                           "choices": extra if kind == "choice" else None,
                           "range": list(extra) if kind == "int" else None,
                           "help": help_, "value": v[k]}
                          for k, sec, label, kind, d, extra, help_ in SCHEMA]))
    elif cmd == "generate":
        generate()
    elif cmd == "apply":
        wm = apply()
        print(f"Applied to {wm}." if wm else "Saved; applies from the next login.")
    elif cmd == "wallpaper":
        wallpaper()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
