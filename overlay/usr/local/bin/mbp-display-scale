#!/usr/bin/env bash
# Prints "OUTPUT SCALE" for every connected display whose preferred mode is
# 1080 pixels tall or more (so 1080p, 1440p, 4K...), read from the kernel
# before any compositor starts. Each flavour's config turns these lines into
# its own scale setting. MBP_SCALE overrides the scale (MBP_SCALE=1 disables).
#   --sway   apply them to the running sway instead of printing
scale=${MBP_SCALE:-1.5}
lines=()
for dir in /sys/class/drm/card*-*; do
    [[ $(cat "$dir/status" 2>/dev/null) == connected ]] || continue
    mode=$(head -n1 "$dir/modes" 2>/dev/null)       # the preferred mode comes first
    [[ $mode =~ ^([0-9]+)x([0-9]+) ]] || continue
    (( BASH_REMATCH[2] >= 1080 )) || continue
    name=${dir##*/}
    lines+=("${name#card*-} $scale")                  # card1-eDP-1 -> eDP-1
done
if [[ ${1-} == --sway ]]; then
    for l in "${lines[@]}"; do swaymsg output "${l% *}" scale "${l#* }" >/dev/null; done
else
    (( ${#lines[@]} )) && printf '%s\n' "${lines[@]}"
fi
exit 0
