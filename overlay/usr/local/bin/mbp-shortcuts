#!/usr/bin/env python3
"""Keyboard shortcuts cheat sheet (Mod+K), in the terminal.

The README's key tables: the ones shared by every flavour, then the running
compositor's. Type to filter, arrows / Page Up / Page Down to scroll, Escape
clears the search or closes.

  mbp-shortcuts            show it here
  mbp-shortcuts --toggle   open it in its own window, or close that window (Mod+K)
"""
import curses
import locale
import os
import subprocess
import sys
import textwrap

README = "/usr/local/share/mbp/README.md"
APP_ID = "mbp-shortcuts"
NAMES = {"sway": "sway", "hyprland": "Hyprland", "mango": "Mango"}
# The accent colours as the nearest of the terminal's 256.
ACCENT_256 = {"blue": 67, "teal": 110, "green": 144, "yellow": 222, "orange": 173,
              "red": 131, "purple": 139, "grey": 242}


def flavour():
    if os.environ.get("SWAYSOCK"):
        return "sway"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    if subprocess.run(["pgrep", "-x", "mango"], capture_output=True).returncode == 0:
        return "mango"
    try:
        return open("/etc/mbp-live").read().strip() or "sway"
    except OSError:
        return "sway"


def tables(fl):
    """[(title, [(keys, action)])]: the shared table, then this flavour's."""
    try:
        text = open(README).read()
    except OSError:
        return []
    out, current, inkeys = [], None, False
    for line in text.splitlines():
        if line.startswith("## "):
            inkeys = line.startswith("## Keys")
            current = ("Everywhere", []) if inkeys else None
            if current:
                out.append(current)
            continue
        if line.startswith("### "):
            current = (f"Only in {NAMES.get(fl, fl)}", []) if inkeys and line[4:].strip().lower() == fl else None
            if current:
                out.append(current)
            continue
        if current and line.startswith("|") and "---" not in line and not line.startswith("| Keys |"):
            cells = [c.strip().replace("\\`", "`").replace("\\\\", "\\").replace("**", "")
                     for c in line.strip().strip("|").split("|")]
            if len(cells) >= 2:
                current[1].append((cells[0], cells[1][:1].upper() + cells[1][1:]))
    return [t for t in out if t[1]]


def accent():
    try:
        name = subprocess.run(["mbp-conf", "get", "ACCENT"], capture_output=True, text=True).stdout.strip()
    except OSError:
        name = ""
    return ACCENT_256.get(name, ACCENT_256["blue"])


def main(scr, data, fl):
    curses.curs_set(0)
    curses.use_default_colors()
    acc = accent() if curses.COLORS >= 256 else curses.COLOR_BLUE
    curses.init_pair(1, acc, -1)                     # keys, section titles
    curses.init_pair(2, 255 if curses.COLORS >= 256 else curses.COLOR_WHITE, acc)   # title bar
    curses.init_pair(3, 245 if curses.COLORS >= 256 else curses.COLOR_WHITE, -1)    # dim text
    KEYS, BAR, DIM = curses.color_pair(1) | curses.A_BOLD, curses.color_pair(2) | curses.A_BOLD, curses.color_pair(3)
    query, top = "", 0
    keyw = max((len(k) for _, rows in data for k, _ in rows), default=10) + 3

    def lines(width):
        """Screen lines; long descriptions wrap under the description column."""
        words = query.lower().split()
        room = max(12, width - 3 - keyw)
        out = []
        for title, rows in data:
            hits = [(k, a) for k, a in rows if all(w in f"{k} {a}".lower() for w in words)]
            if hits:
                if out:
                    out.append(("", "", "gap"))
                out.append((title, "", "title"))
                for k, a in hits:
                    parts = textwrap.wrap(a, room) or [""]
                    out.append((k, parts[0], "row"))
                    out += [("", more, "row") for more in parts[1:]]
        return out

    shown = None
    while True:
        h, w = scr.getmaxyx()
        # A full repaint when the list changes: terminals and curses can
        # disagree on how wide ⌘ and ⇧ are, which would leave stray characters.
        if (query, top, h, w) != shown:
            scr.clear()
            shown = (query, top, h, w)
        else:
            scr.erase()
        bar = f" Keyboard shortcuts · {NAMES.get(fl, fl)}"
        hint = "type to search · ↑↓ scroll · Esc close "
        scr.addnstr(0, 0, bar.ljust(w), w, BAR)
        if len(bar) + len(hint) < w:
            scr.addnstr(0, w - len(hint) - 1, hint, len(hint), BAR)
        scr.addnstr(1, 0, (" Search: " + query + "▏").ljust(w), w, DIM if not query else curses.A_NORMAL)
        body = lines(w)
        view = h - 3
        top = max(0, min(top, len(body) - view))
        shown = (query, top, h, w)
        if not data:
            scr.addnstr(3, 2, f"The shortcut list isn't available ({README} is missing).", w - 3)
        elif not body:
            scr.addnstr(3, 2, "No shortcut matches that.", w - 3, DIM)
        for i, (k, a, kind) in enumerate(body[top:top + view]):
            y = 3 + i
            if kind == "title":
                scr.addnstr(y, 2, k, w - 3, KEYS | curses.A_UNDERLINE)
            elif kind == "row":
                scr.addnstr(y, 2, k, max(0, min(keyw, w - 3)), KEYS)
                if keyw + 2 < w - 1:
                    scr.addnstr(y, 2 + keyw, a, w - 3 - keyw)
        if len(body) > view:
            more = f" {top + 1}–{min(top + view, len(body))} of {len(body)} "
            scr.addnstr(h - 1, max(0, w - len(more) - 1), more, len(more), DIM)
        scr.refresh()

        try:
            ch = scr.get_wch()
        except curses.error:
            continue
        except KeyboardInterrupt:
            return
        if ch in ("\x1b",):
            if query:
                query, top = "", 0
            else:
                return
        elif ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            query, top = query[:-1], 0
        elif ch == "\x15":                            # Ctrl+U
            query, top = "", 0
        elif ch == curses.KEY_UP:
            top -= 1
        elif ch == curses.KEY_DOWN:
            top += 1
        elif ch == curses.KEY_PPAGE:
            top -= view
        elif ch == curses.KEY_NPAGE:
            top += view
        elif ch == curses.KEY_HOME:
            top = 0
        elif ch == curses.KEY_END:
            top = len(body)
        elif isinstance(ch, str) and ch.isprintable():
            query, top = query + ch, 0


def toggle():
    """Close the cheat-sheet window if it's open, otherwise open it."""
    if subprocess.run(["pkill", "-f", "--", f"--app-id={APP_ID} "], capture_output=True).returncode == 0:
        return
    os.execvp("foot", ["foot", f"--app-id={APP_ID}", "--title=Keyboard shortcuts", "mbp-shortcuts"])


if __name__ == "__main__":
    if sys.argv[1:] == ["--toggle"]:
        toggle()
    elif sys.argv[1:] in ([], ["--here"]):
        locale.setlocale(locale.LC_ALL, "")
        os.environ.setdefault("ESCDELAY", "25")      # Escape closes at once
        fl = flavour()
        curses.wrapper(main, tables(fl), fl)
    else:
        sys.exit(__doc__)
