#!/usr/bin/env bash
# Changes volume or brightness and shows the new level in the wob popup.
# sway-osd volume up|down|mute
# sway-osd brightness up|down
# sway-osd keyboard up|down
sock="${XDG_RUNTIME_DIR:-/tmp}/wob.sock"

show() { [[ -p $sock ]] && printf '%s\n' "$1" > "$sock"; }

level_of_volume() {
    # "Volume: 0.45" or "Volume: 0.45 [MUTED]" -> 45, or 0 when muted
    local out; out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
    [[ $out == *MUTED* ]] && { echo 0; return; }
    awk '{printf "%d\n", $2 * 100 + 0.5}' <<< "$out"
}

case "$1 $2" in
    "volume up")       wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; show "$(level_of_volume)" ;;
    "volume down")     wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-;        show "$(level_of_volume)" ;;
    "volume mute")     wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle;       show "$(level_of_volume)" ;;
    "brightness up")   show "$(brightnessctl -m set 5%+ | cut -d, -f4 | tr -d %)" ;;
    "brightness down") show "$(brightnessctl -m set 5%- | cut -d, -f4 | tr -d %)" ;;
    "keyboard up")     show "$(brightnessctl -m -d '*kbd_backlight' set 10%+ | cut -d, -f4 | tr -d %)" ;;
    "keyboard down")   show "$(brightnessctl -m -d '*kbd_backlight' set 10%- | cut -d, -f4 | tr -d %)" ;;
    *) echo "usage: sway-osd volume up|down|mute | brightness up|down | keyboard up|down" >&2; exit 1 ;;
esac
