#!/usr/bin/env bash
# Starts everything a desktop session needs, the same way under sway,
# Hyprland and Mango. Each compositor's config runs this once at startup.

bg() { "$@" >/dev/null 2>&1 & }

# User services (Tether, portals) need the Wayland session's environment.
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
    SWAYSOCK HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP 2>/dev/null
systemctl --user restart tether.service 2>/dev/null

# Brightness at login, from the desktop settings ("keep" leaves it alone)
b=$(mbp-conf get BRIGHTNESS 2>/dev/null)
[[ ${b:-100} == keep ]] || brightnessctl set "${b:-100}%" >/dev/null 2>&1
# Dark everywhere: GTK 4 / libadwaita apps follow color-scheme. GTK 3 apps
# (Thunar, Mousepad...) use the built-in Adwaita theme, made dark by
# gtk-application-prefer-dark-theme in ~/.config/gtk-3.0/settings.ini. (Naming
# "Adwaita-dark" here would make GTK 3 fall back to plain, light Adwaita, since
# no theme of that name is installed.)
gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null
gsettings set org.gnome.desktop.interface gtk-theme Adwaita 2>/dev/null

bg mako
bg /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
bg nm-applet --indicator
bg wl-paste --watch cliphist store
bg udiskie --smart-tray
bg blueman-applet
bg mbp-battery-watch
bg mbp-nightlight start

# Volume/brightness popup: mbp-osd writes levels into this pipe.
sock="${XDG_RUNTIME_DIR:-/tmp}/wob.sock"
rm -f "$sock" && mkfifo "$sock" && { tail -f "$sock" | wob >/dev/null 2>&1 & }

# Lock, screen off and suspend when idle (times from the desktop settings)
bg mbp-idle

# Live USB only: the installation walkthrough.
if [[ -e /etc/mbp-live ]]; then
    bg foot --app-id=live-welcome --title=Install live-welcome
fi
