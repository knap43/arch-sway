<?xml version="1.0" encoding="UTF-8"?>
<!-- Thunar: no menubar (File, Edit, View…). Its menus are behind the menu
     button that appears on the toolbar while the menubar is hidden; Ctrl+M
     shows the menubar again. The toolbar items are Thunar's defaults, plus
     that menu button. -->
<channel name="thunar" version="1.0">
  <property name="last-menubar-visible" type="bool" value="false"/>
  <property name="last-toolbar-items" type="string" value="menu:1,back:1,forward:1,open-parent:1,open-home:1,new-tab:0,new-window:0,toggle-split-view:0,undo:0,redo:0,zoom-out:0,zoom-in:0,zoom-reset:0,view-as-icons:0,view-as-detailed-list:0,view-as-compact-list:0,view-switcher:0,location-bar:1,reload:0,search:1"/>
</channel>
