# Packages installed both in the live ISO and on the installed system.
# One per line; '#' starts a comment.

# --- base & hardware (MacBook Pro 2011: Intel HD 3000, BCM4331; ThinkPad T460s: HD 520, Intel Wi-Fi) ---
base
linux
linux-firmware
intel-ucode
amd-ucode
broadcom-wl-dkms
linux-headers
mesa
libva-intel-driver
intel-media-driver
# Vulkan for the T460s's HD 520 (the MacBook's HD 3000 has none), 64- and 32-bit
vulkan-intel
lib32-vulkan-intel
lib32-mesa
# AMD graphics, in case of other hardware: mesa already brings radeonsi (OpenGL and
# VA-API), linux-firmware the GPU firmware; these add Vulkan (RADV, 64/32-bit)
vulkan-radeon
lib32-vulkan-radeon
xorg-xwayland
sudo
man-db
man-pages
less
btop
fastfetch
nnn
dosfstools
exfatprogs
unzip

# --- Wayland session (shared by every compositor) ---
swaybg
swayidle
gtklock
wlopm
foot
fuzzel
mako
grim
slurp
wl-clipboard
cliphist
libnotify
brightnessctl
playerctl
wob
wlsunset
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
polkit
polkit-gnome
dconf

# --- audio, network, power ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol
networkmanager
network-manager-applet
bluez
bluez-utils
blueman
tlp
zram-generator

# --- shell & fonts ---
fish
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono
# icons in the bar (Wi-Fi, Bluetooth): Nerd Font symbols only
ttf-nerd-fonts-symbols

# --- applications ---
mpv
mpv-mpris
# blurs the wallpaper for the lock screen (mbp-conf); mpv needs it anyway
ffmpeg
kew
# Zen Browser comes from Flathub (see build.sh)
flatpak
thunar
gvfs
gvfs-dnssd
udisks2
udiskie
tumbler
ristretto
zathura
zathura-pdf-mupdf
mousepad
xarchiver

# --- development ---
git
base-devel
vim
python
python-gobject
adwaita-icon-theme
gtk4
libadwaita
python-cryptography
python-aiohttp
python-pygame
python-httpx
# Tether's extras: phone audio (pacat), playing what the phone shares (yt-dlp
# with mpv), the Wake-on-LAN check (ethtool)
libpulse
yt-dlp
ethtool
# RetroHub's interface (Textual, which brings rich)
python-textual
# Settings: display layout and the graphics card's name
wlr-randr
pciutils

# --- games: RetroHub's runners and extras (multilib is enabled for these) ---
umu-launcher
wine
winetricks
gamemode
lib32-gamemode
mangohud
lib32-mangohud
# --- emulators: N64 (DuckStation and PCSX2 come as unpacked AppImages, see
# build.sh); zenity is the ROM picker for mupen64plus
mupen64plus
zenity
