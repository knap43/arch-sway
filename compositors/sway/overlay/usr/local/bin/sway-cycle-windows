#!/usr/bin/env python3
"""Cycle focus through every window on every workspace (like Alt+Tab).
   --reverse  goes backwards."""
import json, subprocess, sys

tree = json.loads(subprocess.run(["swaymsg", "-t", "get_tree"],
                                 capture_output=True, text=True).stdout)


def windows(node, skip=False):
    if node.get("type") == "workspace" and node.get("name") == "__i3_scratch":
        return
    kids = node.get("nodes", []) + node.get("floating_nodes", [])
    if node.get("type") in ("con", "floating_con") and not kids and "pid" in node:
        yield node
    for c in kids:
        yield from windows(c)


wins = list(windows(tree))
if not wins:
    sys.exit()
idx = next((i for i, w in enumerate(wins) if w.get("focused")), -1)
step = -1 if "--reverse" in sys.argv else 1
target = wins[(idx + step) % len(wins)] if idx >= 0 else wins[0]
subprocess.run(["swaymsg", f"[con_id={target['id']}] focus"], capture_output=True)
