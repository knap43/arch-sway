general {
    colors = true
    interval = 5
}

order += "volume master"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "tztime local"

volume master {
    format = "VOL %volume"
    format_muted = "VOL muted"
    device = "pulse"
}
battery all {
    format = "%status %percentage %remaining"
    status_chr = "CHR"
    status_bat = "BAT"
    status_full = "FULL"
    low_threshold = 15
    threshold_type = percentage
    integer_battery_capacity = true
}
cpu_usage {
    format = "CPU %usage"
}
memory {
    format = "RAM %used"
}
tztime local {
    format = "%H:%M"
}
