general {
    colors = true
    markup = "pango"
    interval = 5
}

# Wi-Fi and wired as Nerd Font icons (Symbols Nerd Font); Bluetooth's icon is
# added by mbp-bar-status, which the bar runs around i3status.
order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "tztime local"

wireless _first_ {
    format_up = "<span size='large'>󰤨</span>"
    format_down = "<span size='large'>󰤮</span>"
}
ethernet _first_ {
    format_up = "<span size='large'>󰈀</span>"
    format_down = ""
}
volume master {
    format = "VOL %volume"
    format_muted = "VOL muted"
    device = "pulse"
}
battery all {
    format = "%status %percentage %remaining"
    status_chr = "CHR"
    status_bat = "BAT"
    status_full = "FULL"
    low_threshold = 15
    threshold_type = percentage
    integer_battery_capacity = true
}
cpu_usage {
    format = "CPU %usage"
}
memory {
    format = "RAM %used"
}
tztime local {
    format = "%H:%M"
}
