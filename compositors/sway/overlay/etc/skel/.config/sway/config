# sway — tuned for a 2011 MacBook Pro 13″ (A1278). See `man 5 sway`.
# Mod = Command (⌘) key. Every binding uses --to-code, so it works
# the same whether the US or the Russian layout is active.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel

# ---- Look: no gaps, thin borders, nothing that animates ----------------------
font pango:Noto Sans 10
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
focus_follows_mouse yes
workspace_layout tabbed
output * bg /usr/share/backgrounds/mbp/wallpaper.jpg fill #1e1e1e
# Displays 1080p or taller are scaled 1.5x (MBP_SCALE overrides, 1 = off)
exec_always mbp-display-scale --sway

# class                 border  bg      text    indicator child_border
client.focused          #5e81ac #5e81ac #ffffff #81a1c1   #5e81ac
client.focused_inactive #3b3b3b #3b3b3b #cccccc #3b3b3b   #3b3b3b
client.unfocused        #2a2a2a #2a2a2a #888888 #2a2a2a   #2a2a2a
client.urgent           #bf616a #bf616a #ffffff #bf616a   #bf616a

# ---- Input -------------------------------------------------------------------
input type:keyboard {
    xkb_layout us,ru
    # Alt+Shift switches layout (Option+Shift on a Mac; on a PC keyboard the Win
    # key, which sends Alt after the swap below); Caps Lock and Escape are swapped
    xkb_options grp:alt_shift_toggle,caps:swapescape
    repeat_delay 300
    repeat_rate 35
}

# On a PC keyboard Alt and Win trade places, so ⌘ (Super) is the key next to
# the space bar there too; mbp-xkb-options picks the options for this machine.
exec_always swaymsg "input type:keyboard xkb_options $(mbp-xkb-options)"

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    click_method clickfinger
    scroll_method two_finger
}

# ---- Autostart ---------------------------------------------------------------
# Notifications, tray icons, clipboard history, night light, popups, idle
# lock/suspend, Tether and (on the live USB) the walkthrough: shared by every
# compositor flavour, see /usr/local/bin/mbp-session-start.
exec mbp-session-start

# ---- Apps --------------------------------------------------------------------
bindsym --to-code {
    $mod+d       exec $term
    $mod+space   exec $menu
    $mod+q       exec $menu
    $mod+e       exec thunar
    $mod+b       exec librewolf
    $mod+v       exec cliphist list | fuzzel --dmenu --prompt "Clipboard: " | cliphist decode | wl-copy
}

# ---- Windows -----------------------------------------------------------------
bindsym --to-code {
    $mod+w             kill
    # Mod+Tab: switch this container between tabbed and tiled
    $mod+Tab           layout toggle tabbed split
    # Mod+Shift+Tab: cycle through every window on every workspace
    $mod+Shift+Tab     exec sway-cycle-windows
    $mod+bracketleft   focus prev
    $mod+bracketright  focus next
    $mod+f             fullscreen
    $mod+Shift+f       floating toggle
    $mod+Shift+space   focus mode_toggle
    $mod+p             focus parent
}
floating_modifier $mod normal

# Focus / move with ⌘+H J K L or arrows (add Shift to move the window)
bindsym --to-code {
    $mod+$left   focus left
    $mod+$down   focus down
    $mod+$up     focus up
    $mod+$right  focus right
    $mod+Left    focus left
    $mod+Down    focus down
    $mod+Up      focus up
    $mod+Right   focus right

    $mod+Shift+$left   move left
    $mod+Shift+$down   move down
    $mod+Shift+$up     move up
    $mod+Shift+$right  move right
    $mod+Shift+Left    move left
    $mod+Shift+Down    move down
    $mod+Shift+Up      move up
    $mod+Shift+Right   move right
}

# ---- Workspaces --------------------------------------------------------------
# ⌘+A / ⌘+S: previous / next. Past the last one, ⌘+S opens a fresh empty one.
bindsym --to-code {
    $mod+a        workspace prev_on_output
    $mod+s        exec sway-workspace-next
    $mod+Shift+a  move container to workspace prev_on_output, workspace prev_on_output
    $mod+Shift+s  exec sway-workspace-next --move

    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9
    $mod+0 workspace number 10
    $mod+Shift+1 move container to workspace number 1
    $mod+Shift+2 move container to workspace number 2
    $mod+Shift+3 move container to workspace number 3
    $mod+Shift+4 move container to workspace number 4
    $mod+Shift+5 move container to workspace number 5
    $mod+Shift+6 move container to workspace number 6
    $mod+Shift+7 move container to workspace number 7
    $mod+Shift+8 move container to workspace number 8
    $mod+Shift+9 move container to workspace number 9
    $mod+Shift+0 move container to workspace number 10
}

# ---- Layout ------------------------------------------------------------------
bindsym --to-code {
    $mod+backslash  splith
    $mod+minus      splitv
    $mod+period     layout toggle split
    $mod+comma      layout tabbed
    $mod+t          layout stacking
    # Tiled: this window takes the left half, the rest share the right
    $mod+Return     exec sway-layout left-half
    # Float every window on this workspace, or tile them all again
    $mod+slash      exec sway-layout float-all
    $mod+r          mode "resize"
    $mod+Shift+grave  move scratchpad
    $mod+grave        scratchpad show
}

mode "resize" {
    bindsym --to-code $left  resize shrink width 20px
    bindsym --to-code $down  resize grow height 20px
    bindsym --to-code $up    resize shrink height 20px
    bindsym --to-code $right resize grow width 20px
    bindsym Left   resize shrink width 20px
    bindsym Down   resize grow height 20px
    bindsym Up     resize shrink height 20px
    bindsym Right  resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ---- System ------------------------------------------------------------------
bindsym --to-code {
    $mod+Ctrl+s        exec mbp-screenshot
    $mod+Ctrl+Shift+s  exec mbp-screenshot --full
    $mod+Escape        exec mbp-power-menu
    $mod+Shift+q       exec mbp-power-menu
    $mod+Shift+c       reload
    $mod+n             exec mbp-nightlight toggle
}

# Mac function keys (work on the lock screen too); levels pop up via wob
bindsym --locked {
    XF86MonBrightnessUp   exec mbp-osd brightness up
    XF86MonBrightnessDown exec mbp-osd brightness down
    XF86KbdBrightnessUp   exec mbp-osd keyboard up
    XF86KbdBrightnessDown exec mbp-osd keyboard down
    XF86AudioRaiseVolume  exec mbp-osd volume up
    XF86AudioLowerVolume  exec mbp-osd volume down
    XF86AudioMute         exec mbp-osd volume mute
    XF86AudioPlay         exec playerctl play-pause
    XF86AudioNext         exec playerctl next
    XF86AudioPrev         exec playerctl previous
}

# Dialogs float
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="live-welcome"] floating enable, resize set 780 560, move position center

# ---- Bar ---------------------------------------------------------------------
bar {
    position top
    status_command i3status
    font pango:JetBrains Mono 9
    tray_output *
    colors {
        background #1e1e1e
        statusline #cccccc
        separator  #444444
        focused_workspace  #5e81ac #5e81ac #ffffff
        active_workspace   #3b3b3b #3b3b3b #ffffff
        inactive_workspace #1e1e1e #1e1e1e #888888
        urgent_workspace   #bf616a #bf616a #ffffff
    }
}

include /etc/sway/config.d/*

# Managed by wmai (keep this last so its settings win)
include ~/.config/sway/ai.conf
