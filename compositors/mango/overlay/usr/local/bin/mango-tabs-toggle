#!/usr/bin/env python3
"""Mod+Tab in Mango: switch the focused tag between tabbed (monocle, shown
with a tab bar) and tiled, like `layout toggle tabbed split` in sway."""
import json, subprocess

MONOCLE = "M"          # Mango's layout symbol for monocle


def mmsg(*args):
    return subprocess.run(["mmsg", *args], capture_output=True, text=True).stdout


def monitors(node):
    """Every object in the reply that describes a monitor (has a layout)."""
    if isinstance(node, dict):
        if "layout_symbol" in node:
            yield node
        for value in node.values():
            yield from monitors(value)
    elif isinstance(node, list):
        for value in node:
            yield from monitors(value)


def focused_symbol():
    try:
        mons = list(monitors(json.loads(mmsg("get", "all-monitors"))))
    except ValueError:
        return None
    for mon in mons:
        if any(mon.get(k) is True for k in ("is_focused", "focused", "active", "is_active", "selected")):
            return mon["layout_symbol"]
    return mons[0]["layout_symbol"] if len(mons) == 1 else None


symbol = focused_symbol()
mmsg("dispatch", "setlayout,tile" if symbol == MONOCLE else "setlayout,monocle")
