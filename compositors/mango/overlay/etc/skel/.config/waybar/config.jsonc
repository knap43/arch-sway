// Waybar for the mango flavour; shared look in ~/.config/waybar/style.css
{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "modules-left": [
        "mango/workspaces",
        "mango/keymode"
    ],
    "modules-center": [],
    "modules-right": [
        "wireplumber",
        "battery",
        "cpu",
        "memory",
        "clock",
        "tray",
        "network",
        "bluetooth"
    ],
    "mango/workspaces": {
        "format": "{index}",
        "hide-empty": true,
        "on-click": "activate"
    },
    "mango/keymode": {
        "format-default": ""          // shown only in other modes, e.g. resize
    },
    "network": {
        // Nerd Font icons (Symbols Nerd Font): signal strength, wired, or off
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-linked": "󰤯",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤮",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "tooltip-format-disconnected": "Not connected",
        "on-click": "mbp-settings network"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "mbp-settings bluetooth"
    },
    "wireplumber": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pavucontrol"
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-full": "FULL",
        "states": {
            "warning": 15,
            "critical": 5
        }
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },
    "memory": {
        "format": "RAM {used:0.1f}G",
        "interval": 5
    },
    "clock": {
        "format": "{:%H:%M}",                 // the date is in the tooltip
        "tooltip-format": "{:%A %d %B %Y}"
    },
    "tray": {
        "spacing": 6
    }
}
